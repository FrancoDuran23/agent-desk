# Cuidado — copiá a .env.local para `npm run dev`.
# Nunca commitees secretos.

# Opcional. Sin clave, el recorrido es un simulacro etiquetado.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Prefijo de fetch / EventSource. Webflow Cloud inyecta el mount path como
# COSMIC_MOUNT_PATH en el build (ver next.config.ts). Setealo solo si hace
# falta forzarlo, y tiene que coincidir con el mount path, por ejemplo /app
NEXT_PUBLIC_BASE_PATH=

# Bindings (wrangler.json). Webflow Cloud los aprovisiona.
#   DB     D1   caso reducido
#   HOUSE  KV   sesión
#   MEDIA  R2   metadatos de adjunto, nunca el archivo
