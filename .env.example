# Casa de agentes — copy to .env.local for `npm run dev`.
# Never commit real tokens.

# Optional. Without a key the house runs in SIMULACRO (full season, labeled).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Data API publisher. Without these, Publish shows a dry-run
# with the same payloads the live call would send.
# Token scopes: sites:read, cms:write, pages:write
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=
# If set, the publisher updates this page's SEO / Open Graph.
WEBFLOW_PAGE_ID=
# If set, items go into this collection instead of creating a new one.
WEBFLOW_COLLECTION_ID=

# Client fetch/EventSource prefix. Webflow Cloud injects the mount path as
# COSMIC_MOUNT_PATH at build time (see next.config.ts). Set this only if you
# need to override it — value must match the environment mount path, e.g. /app
NEXT_PUBLIC_BASE_PATH=

# Bindings (wrangler.json). Webflow Cloud provisions them; do not put secrets here.
#   DB     D1   seasons, chat, confessionals, votes, canvas snapshots, MCP ops
#   HOUSE  KV   hot run JSON + producer lock
#   MEDIA  R2   brief, Webflow JSON, MCP playbook, highlight reel
